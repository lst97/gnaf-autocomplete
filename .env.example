# Server
PORT=8000

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/gnaf
POOL_SIZE=10

# G-NAF data directory (path to the PSV files)
GNAF_DATA_DIR=/Users/lst97/Downloads/g-naf_may26_allstates_gda2020_psv_1023/G-NAF/G-NAF MAY 2026/Standard

# Logging: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# CORS: set to specific origin for production, * for development
CORS_ORIGINS=*

# Cloudflare Turnstile (get these from https://dash.cloudflare.com → Turnstile)
# TURNSTILE_SITE_KEY=0x4AAAA...
# TURNSTILE_SECRET_KEY=0x4AAAA...

# API key rate limiting (per-key)
# API_KEY_RATE_LIMIT=1000        # max requests per hour per key
# API_KEY_RATE_WINDOW_MS=3600000

# Blocked TLDs for key registration (space-separated), defaults same as below
# DOMAIN_SPAM_TLDS=".tk .ml .ga .cf .gq .top .xyz .vip .club .bond .cam .ink .life .media .wang .quest .host"

# Cloudflare Tunnel (get token from Cloudflare dashboard → Zero Trust → Tunnels)
# CF_TUNNEL_TOKEN=

# Public URL — requests from this origin skip API key domain mismatch checks
# (so you can test keys from the UI without changing the key's registered domain)
# Set to your API's public URL, e.g. https://api.example.com
# PUBLIC_URL=http://localhost:8000
