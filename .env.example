# Runtime environment: development, production, test
# NODE_ENV=production

# Server
PORT=8000

# PostgreSQL — set a strong password via environment variable.
# Generate one: openssl rand -base64 32
# DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5433/gnaf
# DATABASE_URL_READWRITE=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5433/gnaf  (optional, same as DATABASE_URL if omitted)
POOL_SIZE=10

# G-NAF data directory (path to the PSV files)
# GNAF_DATA_DIR=/path/to/G-NAF/Standard

# G-NAF version label (e.g. "MAY 2026"). Used by the version check scheduler
# and displayed in the UI header. Update this when loading a new dataset.
# GNAF_VERSION=MAY 2026

# Logging: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# CORS: comma-separated origins for production. Empty = same-origin only.
# Only set to * for development if you really need it.
# CORS_ORIGINS=https://myapp.com,https://api.example.com

# Cloudflare Turnstile (get these from https://dash.cloudflare.com → Turnstile)
# TURNSTILE_SITE_KEY=0x4AAAA...
# TURNSTILE_SECRET_KEY=0x4AAAA...

# API key rate limiting (per-key)
# API_KEY_RATE_LIMIT=5000         # max requests per window per key
# API_KEY_RATE_WINDOW_MS=3600000

# Blocked TLDs for key registration (space-separated), defaults same as below
# DOMAIN_SPAM_TLDS=".tk .ml .ga .cf .gq .top .xyz .vip .club .bond .cam .ink .life .media .wang .quest .host"

# Cloudflare Tunnel (get token from Cloudflare dashboard → Zero Trust → Tunnels)
# CF_TUNNEL_TOKEN=

# Public URL — same-origin auth bypass for the keys management UI.
# Set to the API's public URL, e.g. https://api.example.com
# PUBLIC_URL=
