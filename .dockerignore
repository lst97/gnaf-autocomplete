# ============================================================
# Docker build context — exclude everything except what the
# API image needs at runtime: src/, scripts/, sql/, pages/,
# package.json, bun.lock, tsconfig.json.
# ============================================================

# Git + CI
.git
.github
.gitignore
.husky

# Local dev config (AI tools, IDE, env)
.env
.env.*
!.env.example
.omo
.opencode
.codegraph
openspec
.idea
.vscode
.DS_Store

# Dependencies (installed via bun install in Dockerfile)
node_modules

# Build artifacts
dist
out
*.tgz
*.tsbuildinfo

# Tests + benchmarks (not needed in production image)
tests
benchmark
coverage
*.lcov
*.test.ts
*.spec.ts

# Docs (not needed at runtime)
*.md
AGENTS.md
README.md
SECURITY.md
LICENSE

# Docker host config (not needed inside the image)
docker-compose.yml
Dockerfile
.dockerignore
postgresql.conf
biome.json

# Logs + caches
*.log
logs
.eslintcache
.cache
.bun
tmp

